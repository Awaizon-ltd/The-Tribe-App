# Copy this file to .env and fill in your local values.
# Expo reads EXPO_PUBLIC_* vars at build time — restart the dev server after changing.

# Your dev machine's local network IP (find with `ipconfig` on Windows or `ifconfig` on Mac/Linux)
# Leave blank to use the production URL (https://backend.sysfidao.com/api)
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api

# Google Sign-In (expo-auth-session) — from Google Cloud Console, same GCP
# project Firebase created when you enabled Google as an Auth provider.
# Not secrets (OAuth client IDs are public identifiers), safe to have in a
# build, but still per-environment so they're env vars rather than hardcoded.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
