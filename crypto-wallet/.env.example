# Copy this file to .env and fill in your local values.
# Expo reads EXPO_PUBLIC_* vars at build time — restart the dev server after changing.

# Your dev machine's local network IP (find with `ipconfig` on Windows or `ifconfig` on Mac/Linux)
# Leave blank to use the production URL (https://backend.sysfidao.com/api)
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
