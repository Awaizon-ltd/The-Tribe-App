{
  "expo": {
    "name": "Tribe",
    "slug": "the-tribe-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "thetribe",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1017"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.awarizon.tribe",
      "associatedDomains": [
        "applinks:sysfidao.com",
        "applinks:www.sysfidao.com"
      ]
    },
    "android": {
      "versionCode": 1,
      "package": "com.awarizon.tribe",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "thetribe"
            }
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "sysfidao.com",
              "pathPrefix": "/invite"
            }
